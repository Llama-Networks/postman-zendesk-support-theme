<!-- Hero: search first, Support Llama alongside on desktop -->
<section class="ln-hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-12 col-lg-7">
        <h1 class="mb-3">How can we help?</h1>
        <p class="subtitle">Guides, how-tos, and troubleshooting for your Llama Networks services.</p>
        {{search submit=false instant=settings.instant_search placeholder='Search: try "SpeedFusion", "APN settings", "firmware"' class='search search-full ln-hero-search'}}
        <div class="ln-popular">
          <span class="ln-popular-label">Popular:</span>
          <a href="/hc/en-us/search?query=InControl2">InControl2</a>
          <a href="/hc/en-us/search?query=firmware+upgrade">Firmware upgrade</a>
          <a href="/hc/en-us/search?query=SpeedFusion">SpeedFusion setup</a>
          <a href="/hc/en-us/search?query=APN+settings">SIM &amp; APN settings</a>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-flex justify-content-center">
        <img class="ln-hero-art" src="{{asset 'support_llama_small.png'}}"
          srcset="{{asset 'support_llama_small.png'}} 1x, {{asset 'support_llama.svg'}} 2x"
          alt="" width="215" height="400" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- Quick actions: the four jobs people arrive with -->
{{#if settings.show_quick_actions}}
  <section class="ln-actions">
    <div class="container">
      <div class="row">
        <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0 d-flex">
          {{#link 'new_request' class='ln-card ln-action w-100'}}
            <span class="ln-action-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M2.5 3.5h11v8h-6l-3 2.5v-2.5h-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M5.5 6.5h5M5.5 8.75h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
            <span class="ln-action-text">
              <b>Submit a ticket</b>
              <span>Open a support request with our team</span>
            </span>
          {{/link}}
        </div>
        <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0 d-flex">
          {{#link 'requests' class='ln-card ln-action w-100'}}
            <span class="ln-action-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.8V8l2.2 1.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
            <span class="ln-action-text">
              <b>Track my requests</b>
              <span>Check status and reply to open tickets</span>
            </span>
          {{/link}}
        </div>
        <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0 d-flex">
          <a class="ln-card ln-action w-100" href="https://www.llamabilling.com/selfcare.do?party=llama" target="_blank" rel="noopener noreferrer"
            onClick="gtag('event', 'home_click', { block: 'quick-actions', label: 'llama-billing' });">
            <span class="ln-action-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><rect x="2" y="3.5" width="12" height="9" rx="1.2" stroke="currentColor" stroke-width="1.4"/><path d="M2 6.5h12" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
            <span class="ln-action-text">
              <b>Llama Billing</b>
              <span>Invoices, subscriptions, payments</span>
              <span class="ln-ext">↗ llamabilling.com</span>
            </span>
          </a>
        </div>
        <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0 d-flex">
          <a class="ln-card ln-action w-100" href="https://peplink.llamanetworks.com" target="_blank" rel="noopener noreferrer"
            onClick="gtag('event', 'home_click', { block: 'quick-actions', label: 'incontrol2' });">
            <span class="ln-action-ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/><path d="M2.3 8h11.4M8 2c-1.8 1.8-2.6 3.8-2.6 6S6.2 12.2 8 14c1.8-1.8 2.6-3.8 2.6-6S9.8 3.8 8 2z" stroke="currentColor" stroke-width="1.2"/></svg>
            </span>
            <span class="ln-action-text">
              <b>InControl2</b>
              <span>Manage your Peplink fleet</span>
              <span class="ln-ext">↗ peplink.llamanetworks.com</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
{{/if}}

<!-- Browse by product: every knowledge-base category, straight from Zendesk -->
<section class="ln-cats">
  <div class="container">
    <h2 class="mb-1">Browse by product</h2>
    <p class="ln-sub">Documentation for everything we support.</p>
    <div class="row">
      {{#each categories}}
        <div class="col-12 col-md-6 col-lg-4 mb-4 d-flex">
          <div class="ln-card ln-cat-card w-100 d-flex flex-column">
            <h3 class="ln-card-title"><a href="{{url}}">{{name}}</a></h3>
            {{#if description}}
              <p class="ln-card-desc">{{description}}</p>
            {{/if}}
            <a class="ln-arrow-link mt-auto" href="{{url}}">Browse articles →</a>
          </div>
        </div>
      {{else}}
        <div class="col-12">
          <i class="category-empty">No categories yet.</i>
        </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- Peplink spotlight -->
{{#if settings.show_peplink_spotlight}}
  <section class="ln-pep">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-12 col-lg-5 mb-4 mb-lg-0">
          <div class="ln-pep-intro d-flex">
            <img class="ln-pep-badge" src="{{asset 'partner-2.webp'}}" alt="Peplink Certified Platinum Partner" width="120" height="110" loading="lazy" />
            <div class="ln-pep-copy">
              <p class="ln-eyebrow">Certified Platinum Partner</p>
              <h2 class="mb-2">Your Peplink Experts</h2>
              <p class="ln-sub mb-3">Most of our customers run Peplink, and we support it at the highest partner tier. Start here for setup, fleet management, and SpeedFusion.</p>
              <a class="ln-pep-button" href="/hc/en-us/categories/53176250170131-Peplink"
                onClick="gtag('event', 'home_click', { block: 'peplink-spotlight', label: 'all-peplink' });">
                All Peplink articles
              </a>
              <p class="mt-3 mb-0">
                <a class="ln-arrow-link" href="/hc/en-us/sections/53177222016659-Troubleshooting">Something broken? Go to Troubleshooting →</a>
              </p>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-7">
          <div class="row gx-3 ln-pep-link-grid">
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/36217508702739-Getting-Started-with-Peplink">Getting Started with Peplink <span aria-hidden="true">→</span></a>
            </div>
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/30178878214803-Device-Configuration-How-To">Device Configuration &amp; How-To <span aria-hidden="true">→</span></a>
            </div>
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/53177171527059-InControl2-Fleet-Management">InControl2 &amp; Fleet Management <span aria-hidden="true">→</span></a>
            </div>
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/53177185973139-SpeedFusion-Failover">SpeedFusion &amp; Failover <span aria-hidden="true">→</span></a>
            </div>
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/53177221213715-FusionHub">FusionHub <span aria-hidden="true">→</span></a>
            </div>
            <div class="col-12 col-md-6">
              <a class="ln-pep-link" href="/hc/en-us/sections/53177222016659-Troubleshooting">Troubleshooting <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <p class="ln-pep-tools">
            <span>Tools:</span>
            <a href="https://peplink.llamanetworks.com" target="_blank" rel="noopener noreferrer">InControl2 ↗</a>
            <a href="https://www.peplink.com/support/downloads/" target="_blank" rel="noopener noreferrer">Firmware &amp; release notes ↗</a>
            <a href="https://manual.peplink.com/" target="_blank" rel="noopener noreferrer">Peplink manuals ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>
{{/if}}

<!-- Still need help -->
<section class="ln-help">
  <div class="container">
    <h2 class="mb-1">Still need help?</h2>
    <p class="ln-sub">Can’t find it in the docs? Talk to a human.</p>
    <div class="row">
      <div class="col-12 col-lg-5 mb-3 mb-lg-0 d-flex">
        <div class="ln-card ln-help-primary w-100">
          <b>Submit a support request</b>
          <p>Send us the details and we’ll get back to you within one business day. Include your site name or InControl2 group for fastest routing.</p>
          {{#link 'new_request' class='ln-help-btn'}}Submit a request{{/link}}
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-3 mb-3 mb-lg-0 d-flex">
        <div class="ln-card w-100">
          <b>Urgent outage?</b>
          <p>Managed-service customers can reach the NOC 24/7 at the number on your service summary.</p>
          <a class="ln-arrow-link" href="https://www.llamanetworks.com/contact">Emergency contact info →</a>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-4 d-flex">
        <div class="ln-card w-100">
          <b>Talk to sales</b>
          <p>New services, upgrades, or coverage questions: our team can help you scope it.</p>
          <a class="ln-arrow-link" href="https://www.llamanetworks.com/contact"
            onClick="gtag('event', 'home_click', { block: 'help-band', label: 'contact-sales' });">Contact sales →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Recently updated: populated by script.js from the Help Center API -->
{{#if settings.show_recent_articles}}
  <section class="ln-recent" id="ln-recent">
    <div class="container">
      <h2 class="mb-1">Recently updated</h2>
      <p class="ln-sub">The latest guides and fixes from our team.</p>
      <div class="row" id="ln-recent-articles" aria-live="polite"></div>
    </div>
  </section>
{{/if}}
